# Focus & Cafe v2 - 秘密情報の一覧（説明用テンプレート）
#
# このアプリは .env を読み込みません。以下の値はすべてアプリの画面から入力し、
# ローカルの SQLite（backend/data/focus_cafe.db。公開対象外）に保存されます。
# このファイルは「何をどこで設定するか」を示すためのもので、値は空のままで構いません。

# Gmail の IMAP 読み取り（カード利用通知メールから家計簿へ自動反映）
# 設定場所: マネータブ > 入力 > メール自動取り込み
MAIL_USER=
MAIL_APP_PASSWORD=

# Gemini API キー（支出のAI判定・今日のプラン生成。任意。Google AI Studio で無料発行）
# 設定場所: マネータブ > 入力 > AI判定の設定
GEMINI_API_KEY=

# Google Apps Script ブリッジ（Googleカレンダー同期・iPhoneショートカット連携）
# 設定場所: カレンダータブ > Google連携の設定。手順は docs/SETUP_GOOGLE_SYNC.md
# GAS 側は gas/gas_bridge.gs の TOKEN を同じ値に書き換える（既定値は CHANGE_ME）
GAS_URL=
GAS_TOKEN=
